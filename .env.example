# JobHunterKit Environment Variables
# Copy this file to .env and configure your keys

# 1. AI API Configuration (Mandatory for AI CV Tailoring & Review)
# Get a free Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 2. Database Configuration (Optional - only needed for automated multi-channel job scraping)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=job_hunter
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_password

# 3. Notification Configuration (Optional)
# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id
